---
import { t } from '../i18n';
import { Separator } from '@/components/starwind/separator';
import { canonicalUrl } from '../config/seo';

const resourceLinks = [
  { href: '/blog/', label: 'Blog archive', ariaLabel: 'Blog archive' },
  { href: '/products/dbd-cheats/elite/', label: 'Private suite', ariaLabel: 'Private suite' },
  { href: '/products/dbd-cheats/hwid-spoofer/', label: 'HWID Spoofer', ariaLabel: 'HWID Spoofer utility' },
  { href: '/products/dbd-cheats/ugc/', label: 'Game Accounts', ariaLabel: 'Game Accounts utility' },
  { href: '/products/dbd-cheats/skin-changer/', label: 'Skin Changer', ariaLabel: 'Skin Changer utility' },
  { href: '/products/dbd-cheats/', label: 'Products & utilities', ariaLabel: 'Products & utilities' },
  { href: '/support/', label: t.footer.support },
  { href: '/forum/', label: 'Buyer forum', ariaLabel: 'Buyer forum' },
  { href: '/sitemap.xml', label: 'XML sitemap', ariaLabel: 'XML sitemap' },
];

const legalLinks = [
  { href: '/about/', label: t.footer.about },
  { href: '/privacy/', label: t.footer.privacy },
  { href: '/terms/', label: t.footer.terms },
];

const sharePath = Astro.url.pathname.endsWith('/') || Astro.url.pathname === '/'
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const shareUrl = encodeURIComponent(canonicalUrl(sharePath === '' ? '/' : sharePath));
const shareText = encodeURIComponent(t.site.name);
---

<footer class="border-t border-border bg-muted/30 py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center gap-2.5" aria-label={t.ui.homeAria}>
          <picture>
            <source srcset="/images/brand/dbd-mark-160.webp" type="image/webp" />
            <img src="/images/brand/dbd-mark-160.png" alt="DBD Cheats mark" width="40" height="40" class="size-8 rounded-full object-contain sm:size-9" decoding="async" />
          </picture>
        </a>
        <p class="text-sm text-muted-foreground">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.explore}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.explore}</p>
        <ul class="mt-3 space-y-2">
          {t.footer.exploreLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground hover:text-primary"
                aria-label={link.ariaLabel}
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                <span class="sr-only">Explore · </span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.support}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.support}</p>
        <ul class="mt-3 space-y-2">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary" aria-label={link.ariaLabel}>
                <span class="sr-only">Resources · </span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.legal}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.legal}</p>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary">
                <span class="sr-only">Legal · </span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <Separator class="my-8" />
    <p class="text-left text-sm text-muted-foreground">
      Share:
      <a
        class="underline hover:text-primary"
        href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`}
        rel="noopener noreferrer"
        target="_blank"
      >Share site on X</a>
      ·
      <a
        class="underline hover:text-primary"
        href={`https://www.reddit.com/submit?url=${shareUrl}&title=${shareText}`}
        rel="noopener noreferrer"
        target="_blank"
      >Share site on Reddit</a>
    </p>
    <p class="mt-3 text-left text-sm text-muted-foreground">
      &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
    </p>
  </div>
</footer>
