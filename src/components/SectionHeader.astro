---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  centered?: boolean;
  wide?: boolean;
  /** Page-level title only. Defaults to h2 so each page keeps a single h1. */
  as?: 'h1' | 'h2';
}

const { eyebrow, title, desc, titleId, centered = false, wide = false, as = 'h2' } = Astro.props;
const TitleTag = as;
---

<header
  class:list={[
    'section-header space-y-0',
    wide && 'section-header--wide',
    centered && 'mx-auto text-center',
  ]}
>
  <p class="section-header__eyebrow">{eyebrow}</p>
  <TitleTag id={titleId} class="section-header__title">{title}</TitleTag>
  {desc ? <p class="section-header__subtitle">{desc}</p> : null}
</header>
